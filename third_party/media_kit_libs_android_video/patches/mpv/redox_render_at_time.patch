+    int64_t now = monotonic_ns();
+    int64_t ahead = frame->pts > 0 ? frame->pts - mp_time_ns() : 0;
+    if (frame->still || ahead <= 0 || ahead > 1000000000LL) {
+        av_mediacodec_release_buffer(buffer, 1);
+    } else {
+        av_mediacodec_render_buffer_at_time(buffer, now + ahead);
+    }
 }
 
