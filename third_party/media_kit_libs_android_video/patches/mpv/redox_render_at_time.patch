+// RedoX: frames are handed to MediaCodec with their display time instead of
+// "render now". The compositor then shows each frame on the right vsync; with
+// immediate release a slow device (Chromecast with Google TV) let the next
+// frame replace one before it was shown (~0.7% of frames lost).
+static int64_t monotonic_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
