+    AVMediaCodecBuffer *buffer = (AVMediaCodecBuffer *)frame->current->planes[3];
+    // frame->pts is in mp_time_ns() units (CLOCK_MONOTONIC_RAW based);
+    // MediaCodec expects System.nanoTime() (CLOCK_MONOTONIC). The offset is
